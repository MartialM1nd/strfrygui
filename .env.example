STRFRY_SCAN_MAX_LINE_BYTES=262144
STRFRY_TERMINATE_GRACE_SECONDS=1
STRFRYGUI_POLICY_DIR=/var/lib/strfrygui/policy
STRFRYGUI_PLUGIN_STATE_DIR=/var/lib/strfrygui/plugin
STRFRYGUI_LOCK_DIR=/run/strfrygui
STRFRY_METRICS_URL=http://localhost:7777/metrics
STRFRY_METRICS_TIMEOUT=5
STRFRY_METRICS_MAX_RESPONSE_BYTES=262144
STRFRY_METRICS_MAX_ADDRESSES=4
DASHBOARD_SAMPLE_INTERVAL=60
TRUSTED_PROXY_COUNT=1
