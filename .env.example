# Required: Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Required for first-time registration: Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
REGISTRATION_TOKEN=

DATABASE_URL=sqlite:////opt/strfrygui/strfrygui.db

STRFRY_BINARY=/usr/local/bin/strfry
STRFRY_CONFIG=/usr/local/etc/strfry.conf
STRFRY_DB_PATH=/var/db/strfry
STRFRY_METRICS_URL=http://localhost:7777/metrics
MODERATION_PURGE_TIMEOUT=30
DOMAIN_SCAN_EVENT_LIMIT=500
DOMAIN_SCAN_TIMEOUT=30
DOMAIN_SCAN_CANDIDATE_LIMIT=50
DOMAIN_SCAN_TOTAL_TIMEOUT=120
NIP05_HTTP_TIMEOUT=5
NIP05_MAX_RESPONSE_BYTES=262144
NIP05_MAX_ADDRESSES=4
NIP05_MAX_NAMES=1000
NIP05_MAX_RELAYS=8
NIP05_PROFILE_TIMEOUT=10
NIP05_RELAY_TIMEOUT=3
NIP05_MAX_WS_MESSAGE_BYTES=262144

# External relays for metadata lookup (one per line)
EXTERNAL_RELAYS=wss://relay.damus.io
EXTERNAL_RELAYS=wss://nos.lol
