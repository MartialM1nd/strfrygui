MODERATION_REPORT_MAX_EVENT_BYTES=65536
MODERATION_REPORT_MAX_CONTENT_BYTES=4096
MODERATION_REPORT_MAX_TAGS=64
MODERATION_REPORT_ACCEPT_LIMIT=50
MODERATION_REPORT_REPORTER_LIMIT=20
