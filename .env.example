# Required: Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Required for first-time registration: Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
REGISTRATION_TOKEN=
# Required: externally visible HTTPS origin used in signed NIP-98 events
PUBLIC_BASE_URL=https://relay-admin.example.com
NOSTR_AUTH_CHALLENGE_TTL=60
NOSTR_AUTH_TIMESTAMP_TOLERANCE=60

DATABASE_URL=sqlite:////var/lib/strfrygui/control/strfrygui.db

