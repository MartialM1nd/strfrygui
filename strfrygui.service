[Unit]
Description=StrfryGUI - Nostr Relay Management Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
SupplementaryGroups=strfry-observers
WorkingDirectory=/opt/strfrygui
Environment="PATH=/opt/strfrygui/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="STRFRYGUI_POLICY_DIR=/var/lib/strfrygui/policy"
Environment="STRFRYGUI_PLUGIN_STATE_DIR=/var/lib/strfrygui/plugin"
Environment="STRFRYGUI_LOCK_DIR=/run/strfrygui"
ExecStart=/opt/strfrygui/venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 1 --worker-class gthread --threads 8 --timeout 300 --graceful-timeout 30 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0027
RuntimeDirectory=strfrygui
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
RemoveIPC=yes
TasksMax=128
LimitNOFILE=4096
ReadWritePaths=/var/lib/strfrygui /run/strfrygui
ReadWritePaths=-/var/lib/strfry
ReadWritePaths=-/etc/strfry.conf

[Install]
WantedBy=multi-user.target
